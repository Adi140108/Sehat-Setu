rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is from authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check if user possesses admin custom claims
    function isAdmin() {
      return isAuthenticated() && (request.auth.token.admin == true || request.auth.token.role == 'admin');
    }

    // User profile: User can read/write their own profile. Admin can read/write all.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId
                    && request.resource.data.role == 'citizen' // Prevent self-assigning non-citizen roles
                    && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(userId)
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid', 'createdAt'])) // Cannot change role, uid, or createdAt
                    && (request.resource.data.uid == request.auth.uid);
      allow delete: if isOwner(userId) || isAdmin();

      // Subcollections under users/{userId} for user-scoped rules
      match /family/{familyMemberId} {
        allow read, write: if isOwner(userId);
      }
      match /savedFacilities/{facilityId} {
        allow read, write: if isOwner(userId);
      }
      match /savedProducts/{productId} {
        allow read, write: if isOwner(userId);
      }
      match /documents/{documentId} {
        allow read, write: if isOwner(userId);
      }
      match /sehatPass/{passId} {
        allow read, write: if isOwner(userId);
      }
      match /preferences/{preferenceId} {
        allow read, write: if isOwner(userId);
      }
      match /healthcareJourneys/{journeyId} {
        allow read, write: if isOwner(userId);
      }
    }

    // User private data: Only the user can access their own private data
    match /userPrivate/{userId} {
      allow read, write: if isOwner(userId);
    }

    // User preferences: Only the user can access their own preferences
    match /userPreferences/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Family records: Only the owner (the user who created it) can read/write their own family records
    match /families/{familyId} {
      allow read: if isAuthenticated() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
    }

    // Sehat Pass: Only the owner can access their own pass
    match /sehatPasses/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow delete: if isOwner(userId);
    }

    // Auth audit: Only the authenticated user can create their own audit record, read restricted to owner and admin
    match /authAudit/{eventId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Saved facilities: Owner read/write
    match /savedFacilities/{savedId} {
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Healthcare Journeys: Owner read/write, Admin read/update/delete
    match /healthcareJourneys/{journeyId} {
      allow read, delete, update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Support Requests: Owner read/write, Admin read/update/delete
    match /supportRequests/{requestId} {
      allow read, delete, update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Government/Static datasets: Public read access, Admin write access
    match /facilities/{facilityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /schemes/{schemeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Jan Aushadhi Catalogs: Public read, Admin write
    match /janaushadhiProducts/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /janaushadhiKendras/{kendraId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Saved Medicines: Owner read/write
    match /savedMedicines/{savedId} {
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Sehat Pass Verification Lookup Tokens: Public read, owner write
    match /sehatPassTokens/{tokenId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }

    // Analytics Events: Citizens can write/create, Admins can read/write
    match /analyticsEvents/{eventId} {
      allow create: if true; // Allow anonymous logging of access router searches
      allow read, update, delete: if isAdmin();
    }

    // Feedback: Citizens can create/read their own, Admins can read/write all
    match /feedback/{feedbackId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Facility Reports: Authenticated users can create, Admins can read/write
    match /facilityReports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // System Health: Admin read/write only
    match /systemHealth/{docId} {
      allow read, write: if isAdmin();
    }

    // Admin Logs: Admin read/write only
    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
